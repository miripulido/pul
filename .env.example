# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://pul.studio

# --- Enquiry delivery (server-side) ---
# The enquiry form posts to /api/enquiry. To deliver real enquiries, set ONE of
# the options below and wire it up in src/app/api/enquiry/route.ts.
#
# Option A — Resend (recommended, minimal):
# RESEND_API_KEY=
# ENQUIRY_TO=studio@pul.studio
# ENQUIRY_FROM=enquiries@pul.studio
#
# Option B — any SMTP / transactional provider of your choice.
